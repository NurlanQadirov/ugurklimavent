# Copy to `.env` and fill in before running the app.

# SQLite file, relative to the project root.
DATABASE_URL="file:./prisma/dev.db"

# NextAuth v5 signing secret. Generate one with: npx auth secret
AUTH_SECRET=""

# Set on a server that sits behind Nginx/Caddy, so NextAuth trusts the
# forwarded host instead of refusing to build redirects.
AUTH_TRUST_HOST="true"

# The public origin, scheme and port included. `AUTH_TRUST_HOST` alone is not
# enough: the route handler builds its redirect URLs from the request Next
# hands it, which behind a proxy is the loopback address it is actually
# listening on — every sign-in and sign-out redirect would point at
# `http://localhost:<port>`. Setting this pins them to the real origin.
# Leave it unset in local development.
AUTH_URL="https://example.com"

# The administrator `npm run db:seed` creates. Re-seeding never resets the
# password of an account that already exists, so change it after first login.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
