# Systemd unit for the site. Install with:
#
#   sudo cp deploy/ugurklimavent.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ugurklimavent
#
# One process, deliberately. SQLite takes a single writer, so a second instance
# sharing the same file would serialise badly at best and corrupt at worst.
[Unit]
Description=Ugur Klima Vent (Next.js)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/apps/ugurklimavent
EnvironmentFile=/srv/apps/ugurklimavent/.env
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ugurklimavent

# Təhlükəsizlik
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/apps/ugurklimavent

[Install]
WantedBy=multi-user.target
