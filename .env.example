# Copy to `.env` and fill in before running the app.

# SQLite file, relative to the project root.
DATABASE_URL="file:./prisma/dev.db"

# NextAuth v5 signing secret. Generate one with: npx auth secret
AUTH_SECRET=""

# Set on a server that sits behind Nginx/Caddy, so NextAuth trusts the
# forwarded host instead of refusing to build redirects. Leave `AUTH_URL`
# unset and redirects follow whatever host the request actually arrived on.
AUTH_TRUST_HOST="true"

# The administrator `npm run db:seed` creates. Re-seeding never resets the
# password of an account that already exists, so change it after first login.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
